# Copia este archivo como .env y completa solo los proveedores que decidas usar.
# El perfil local-only futuro no deberá requerir ninguna de estas claves.

# Router, razonamiento y gestión en nube (opcionales durante la transición)
GROQ_API_KEY=
GEMINI_API_KEY=

# Búsqueda web (opcional)
SERPER_API_KEY=

# Directorio de datos (memoria, logs, auditoría, RAG, workspace).
# Vacío = comportamiento histórico: OneDrive\Taller_IA si existe, si no %USERPROFILE%\Taller_IA.
# Pon una ruta para fijarlo (p. ej. una carpeta local que NO se sincroniza).
LARA_DATA_DIR=
# 1 = usar %USERPROFILE%\Taller_IA aunque OneDrive exista (datos solo en este equipo).
LARA_DATA_LOCAL=0

# Interruptor EXCLUSIVO para desarrollo aislado. Déjalo en 0 en uso normal.
LARA_ENABLE_EXPERIMENTAL_TOOLS=0

# Investigación proactiva en nube apagada; las consultas explícitas siguen disponibles.
LARA_CLOUD_BACKGROUND=0
# Orden opcional; comprobar disponibilidad de modelos en la cuenta del proveedor.
# LARA_CLOUD_MODELS=llama-3.1-8b-instant,openai/gpt-oss-120b
# El perfil automático reduce consumo en PCs de hasta 9 GB RAM. Overrides:
# LARA_WHISPER_MODEL=small
# LARA_OLLAMA_NUM_CTX=2048
# LARA_OLLAMA_THREADS=3
# Perfil local pequeño: instalar Ollama y descargar el modelo primero.
# Mantener comentado hasta medir el equipo. No se descargan pesos al iniciar LARA.
# LARA_LLM_LOCAL=1
# LARA_OLLAMA_MODEL=qwen3:1.7b
# LARA_OLLAMA_URL=http://127.0.0.1:11434
# LARA_OLLAMA_KEEP_ALIVE=60s
# LARA_OLLAMA_THINK=0

# FreeLLMAPI opcional: servicio separado local. No reutilizar aquí claves upstream.
LARA_GATEWAY_ENABLED=0
LARA_GATEWAY_URL=http://127.0.0.1:3001/v1
LARA_GATEWAY_API_KEY=
LARA_GATEWAY_TIMEOUT=20
LARA_GATEWAY_CHAT_MODEL=auto:smart
# Razonamiento/código: explícito; nunca auto ni modelos de moderación.
LARA_GATEWAY_REASONING_MODEL=openai/gpt-oss-120b
# Modelos EXACTOS aprobados para decisiones. Vacío conserva router histórico.
# No se permiten aliases auto para acciones. Respuesta model debe pertenecer a esta lista.
LARA_GATEWAY_ACTION_MODELS=
# Registro de ejemplos local, apagado hasta activarlo en el chat o por CLI.
# Incluye pregunta/respuesta redactadas: la redacción es heurística, requiere revisión.
LARA_LEARNING_CAPTURE=0

# Open Code: planificación inicial local, sin una petición cloud adicional.
LARA_CODE_PLAN_LLM=0
# Presupuesto de decisiones entre proveedores (no incluye ejecución de pruebas).
LARA_CODE_DECISION_TIMEOUT=30
